{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(/docs/reference/reference.pdf)",
      "Edit(/docs/reference/reference.pdf)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect_reference_pdf.sh\" || exit 2",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Grep|Glob|Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/sl1_guard.sh\"; [ -r \"$f\" ] || exit 0; sh \"$f\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
